          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "device_ids": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "integer",
                      "minimum": 1
