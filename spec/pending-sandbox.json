            "code": {
              "type": [
                "integer",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "device_unavailable",
                "insufficient_balance",
                "window_closed",
                "recipient_unreachable",
                "template_not_found",
                "template_unresolved_placeholder",
                "not_queued",
                "not_sent",
                null
              ]
            }
          },
          "required": [
            "code",
            "title",
            "reason"
          ]
        }
      },
      "example": {
        "id": "evt_000000000000000000000014",
        "type": "message.status_changed",
        "version": 1,
        "occurred_at": "2026-10-01T12:00:00Z",
        "data": {
          "message_id": 1001,
          "contact_id": 2001,
          "device_id": 4521,
          "status": "failed",
          "previous_status": "sent",
          "error": {
            "code": 131047,
            "title": "Re-engagement message",
            "reason": null
          },
          "occurred_at": "2026-10-01T12:00:00Z",
          "client_reference": "pedido-1001"
        }
      }
    }
