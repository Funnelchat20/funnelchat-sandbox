      "x-fc-pending": "conversations-c2",
      "requestBodyProperties": { "client_reference": { "$ref": "#/components/schemas/PendingClientReference" } }
    }
  ],
  "webhooks": {
    "message.status_changed": {
      "post": {
        "summary": "message.status_changed",
        "description": "Cambió el estado de entrega de un mensaje 1:1 enviado. Un aviso por transición, nunca uno que retroceda. Hay que pedirlo de forma explícita en `events`.",
        "x-fc-status": "planned",
        "x-fc-domain": "conversations",
        "x-fc-pending": "conversations-c1",
        "x-fc-replace-while": { "x-fc-status": "planned" },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "message_id": { "type": "integer", "description": "El `id` del mensaje en el historial del contacto." },
                      "contact_id": { "type": "integer" },
                      "device_id": { "type": ["integer", "null"], "description": "El número de tu cuenta que envió el mensaje." },
                      "status": { "type": "string", "enum": ["sent", "delivered", "read", "failed"] },
                      "previous_status": { "type": ["string", "null"], "enum": ["sent", "delivered", "read", "failed", null] },
                      "error": {
                        "type": "object",
                        "description": "Solo cuando `status` es `failed`.",
                        "properties": {
                          "code": { "type": ["integer", "null"] },
                          "title": { "type": ["string", "null"] }
                        },
                        "required": ["code", "title"]
                      },
                      "occurred_at": { "type": "string", "format": "date-time" },
                      "client_reference": { "type": ["string", "null"], "description": "La `client_reference` que mandaste en el envío, o `null`." }
                    },
                    "required": ["message_id", "contact_id", "device_id", "status", "previous_status", "occurred_at", "client_reference"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "device.connected": {
      "post": {
        "summary": "device.connected",
        "description": "Uno de los números de la cuenta quedó conectado: al escanear el código QR o al terminar el alta de un número de WhatsApp Cloud.",
        "x-fc-status": "live",
        "x-fc-domain": "accounts",
        "x-fc-pending": "accounts-webhooks",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "device": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "name": { "type": ["string", "null"] },
                          "number": { "type": ["string", "null"], "description": "Solo dígitos, sin `+`." }
                        },
                        "required": ["id", "name", "number"]
                      },
                      "connected_at": { "type": "string", "format": "date-time" }
                    },
                    "required": ["device", "connected_at"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "device.disconnected": {
      "post": {
        "summary": "device.disconnected",
        "description": "Uno de los números de la cuenta se desconectó y dejó de poder enviar o recibir.",
        "x-fc-status": "live",
        "x-fc-domain": "accounts",
        "x-fc-pending": "accounts-webhooks",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "device": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "name": { "type": ["string", "null"] },
                          "number": { "type": ["string", "null"], "description": "Solo dígitos, sin `+`." }
                        },
                        "required": ["id", "name", "number"]
                      },
                      "disconnected_at": { "type": "string", "format": "date-time" }
                    },
                    "required": ["device", "disconnected_at"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "billing.payment_failed": {
      "post": {
        "summary": "billing.payment_failed",
        "description": "Un cobro de la suscripción no pudo procesarse (solo suscripciones de Stripe).",
        "x-fc-status": "live",
        "x-fc-domain": "accounts",
        "x-fc-pending": "accounts-webhooks",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" }, "example": { "data": { "amount_cents": 2990, "currency": "USD" } } } } }
      }
    },
    "billing.plan_blocked": {
      "post": {
        "summary": "billing.plan_blocked",
        "description": "El plan quedó bloqueado por un cobro no procesado. Planificado: todavía no se emite.",
        "x-fc-status": "planned",
        "x-fc-domain": "accounts",
        "x-fc-pending": "accounts-webhooks",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } }
      }
    },
    "billing.upcoming_charge": {
      "post": {
        "summary": "billing.upcoming_charge",
        "description": "Se acerca el próximo cobro de la suscripción (solo suscripciones de Stripe).",
        "x-fc-status": "live",
        "x-fc-domain": "accounts",
        "x-fc-pending": "accounts-webhooks",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" }, "example": { "data": { "charge_date": "2026-11-05T00:00:00Z", "amount_cents": 2990, "currency": "USD" } } } } }
      }
    },
    "subscription.expiring": {
      "post": {
        "summary": "subscription.expiring",
        "description": "La suscripción está próxima a vencer. Planificado: todavía no se emite.",
        "x-fc-status": "planned",
        "x-fc-domain": "accounts",
        "x-fc-pending": "accounts-webhooks",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } }
      }
    },
    "subscription.trial_ending": {
      "post": {
        "summary": "subscription.trial_ending",
        "description": "El período de prueba está por terminar.",
        "x-fc-status": "live",
