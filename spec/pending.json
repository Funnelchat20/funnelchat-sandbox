{
  "x-fc-pending": {
    "title": "Pendiente de la especificación",
    "description": "Rutas, campos y eventos que la API ya tiene (o tiene en una rama sin mergear) pero que la instantánea de spec/funnelchat.json todavía no trae. scripts/generate.mjs los suma a la especificación antes de generar los tipos, solo mientras la instantánea no los tenga: cuando una instantánea nueva los trae, la generación usa la de la instantánea y avisa qué entradas de este archivo ya se pueden borrar.",
    "rules": {
      "paths": "Una operación (método + ruta) se agrega solo si la instantánea no la tiene.",
      "operationPatches": "Un parche agrega propiedades al cuerpo de una operación de la instantánea solo mientras esa operación cumple la condición de `while`.",
      "webhooks": "Un evento se agrega si la instantánea no lo tiene, o lo reemplaza mientras cumple la condición de `x-fc-replace-while`.",
      "components.schemas": "Los esquemas de esta capa empiezan con `Pending` para no chocar con los de la instantánea."
    },
    "sources": {
      "accounts-webhooks": "accounts origin/main @ c34cba2c (2026-10-16): back/routes/api/webhooks.php, Http/Controllers/WebhookSubscription*Controller.php, Http/Requests/*WebhookSubscriptionRequest.php, Http/Resources/WebhookSubscription*Resource.php, Catalogs/Areas/*Events.php. En producción desde el 13-10 (accounts #978).",
      "conversations-c2": "conversations feat/armar-funnelchat-f1 @ eadef46c (PR #2284, SIN MERGEAR): envío con clave (contrato 1014, C2) y client_reference.",
      "conversations-c1": "conversations feat/armar-funnelchat-f1 @ eadef46c (PR #2284, SIN MERGEAR): forma de data de message.status_changed (contrato 1014, C1)."
    }
  },
  "components": {
    "schemas": {
      "PendingClientReference": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[\\x21-\\x7E]{1,64}$",
        "description": "Tu referencia para correlacionar el envío con el historial y con `message.status_changed`: de 1 a 64 caracteres ASCII visibles, sin espacios. No es única ni está autenticada; no pongas datos personales. Pendiente de la especificación (conversations PR #2284, sin mergear)."
      },
      "PendingWebhookSubscriptionFilters": {
        "type": "object",
        "properties": {
          "campaign_ids": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "minLength": 6, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
            "description": "Solo entrega los eventos de estas campañas. Un evento sin campaña no pasa el filtro."
          }
        }
      },
      "PendingWebhookSubscription": {
        "type": "object",
        "description": "Una suscripción de webhook unificada. Nunca trae el secreto.",
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "Identificador de la suscripción. Guardalo al crearla: es lo que identifica la tuya." },
          "url": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "events": { "type": "array", "items": { "type": "string" } },
          "filters": { "$ref": "#/components/schemas/PendingWebhookSubscriptionFilters" },
          "status": { "type": "string", "enum": ["active", "paused", "disabled"] },
          "disabled_reason": { "type": ["string", "null"], "enum": ["too_many_failures", "key_revoked", null] },
          "last_delivery_at": { "type": ["string", "null"], "format": "date-time" },
          "last_success_at": { "type": ["string", "null"], "format": "date-time" },
          "secret_rotated_at": { "type": ["string", "null"], "format": "date-time" },
          "created_at": { "type": ["string", "null"], "format": "date-time" },
          "updated_at": { "type": ["string", "null"], "format": "date-time" },
          "migration": {
            "type": ["object", "null"],
            "properties": {
              "origin": { "type": "string" },
              "status": { "type": "string" },
              "activated_via": { "type": ["string", "null"] },
              "activated_at": { "type": ["string", "null"], "format": "date-time" },
              "last_result": {}
            },
            "required": ["origin", "status", "activated_via", "activated_at", "last_result"]
          }
        },
        "required": ["id", "url", "description", "events", "filters", "status", "disabled_reason", "last_delivery_at", "last_success_at", "secret_rotated_at", "created_at", "updated_at", "migration"]
      },
      "PendingWebhookSubscriptionWithSecret": {
        "allOf": [
          { "$ref": "#/components/schemas/PendingWebhookSubscription" },
          {
            "type": "object",
            "properties": {
              "secret": { "type": "string", "description": "El secreto completo para verificar la firma. Se muestra una sola vez: guardalo." },
              "secret_notice": { "type": "string" }
            },
            "required": ["secret", "secret_notice"]
          }
        ]
      },
      "PendingWebhookSubscriptionCreate": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "maxLength": 2048, "description": "`https`, pública y sin usuario ni contraseña." },
          "description": { "type": ["string", "null"], "maxLength": 160 },
          "events": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" }, "description": "Tipos del catálogo (`GET /api/v1/webhooks/events`). La clave necesita el permiso `{área}:read` del área de cada tipo." },
          "filters": {
            "anyOf": [{ "$ref": "#/components/schemas/PendingWebhookSubscriptionFilters" }, { "type": "null" }]
          }
        },
        "required": ["url", "events"]
      },
      "PendingWebhookSubscriptionUpdate": {
        "allOf": [
          { "$ref": "#/components/schemas/PendingWebhookSubscriptionCreate" },
          {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["active", "paused"], "description": "Opcional. `disabled` no se puede pedir." }
            }
          }
        ]
      },
      "PendingWebhookSubscriptionDelivery": {
        "type": "object",
        "description": "Un intento de entrega. Los intentos de un mismo evento comparten `event_id`.",
        "properties": {
          "id": { "type": "integer" },
          "event_id": { "type": "string" },
          "event_type": { "type": "string" },
          "attempt": { "type": "integer" },
          "url": { "type": "string" },
          "response_status": { "type": ["integer", "null"] },
          "succeeded": { "type": "boolean" },
          "error": { "type": ["string", "null"] },
          "duration_ms": { "type": ["integer", "null"] },
          "attempted_at": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["id", "event_id", "event_type", "attempt", "url", "response_status", "succeeded", "error", "duration_ms", "attempted_at"]
      },
      "PendingWebhookSubscriptionTestResult": {
        "type": "object",
        "description": "Resultado de la entrega de prueba (`webhook.test`). Responde 200 aunque tu servidor falle: mirá `succeeded`.",
        "properties": {
          "succeeded": { "type": "boolean" },
          "response_status": { "type": ["integer", "null"] },
          "error": { "type": ["string", "null"] },
          "duration_ms": { "type": ["integer", "null"] },
          "delivery_id": { "type": "integer" }
        },
        "required": ["succeeded", "response_status", "error", "duration_ms", "delivery_id"]
      },
      "PendingMessage": {
        "type": "object",
        "properties": { "message": { "type": "string" } },
        "required": ["message"]
      }
    }
  },
  "paths": {
    "/api/v1/webhooks": {
      "get": {
        "operationId": "pendingWebhookSubscription.index",
        "summary": "Listar las suscripciones de webhook",
        "description": "Todas las suscripciones de la cuenta (como máximo 50), también las que crearon otras integraciones. Solo el titular de la cuenta.\n\n**Pendiente de la especificación** (accounts origin/main @ c34cba2c).",
        "tags": ["Webhooks"],
        "x-fc-domain": "accounts",
        "x-fc-permission": "accounts:read",
        "x-fc-pending": "accounts-webhooks",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PendingWebhookSubscription" } } } }
          }
        }
      },
      "post": {
        "operationId": "pendingWebhookSubscription.store",
        "summary": "Crear una suscripción de webhook",
        "description": "Devuelve el `secret` una sola vez. Tope: 50 suscripciones por cuenta (la siguiente responde 422).\n\n**Pendiente de la especificación** (accounts origin/main @ c34cba2c).",
        "tags": ["Webhooks"],
        "x-fc-domain": "accounts",
        "x-fc-permission": "accounts:write",
        "x-fc-pending": "accounts-webhooks",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PendingWebhookSubscriptionCreate" } } }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PendingWebhookSubscriptionWithSecret" } } }
          },
          "422": {
            "description": "URL rechazada, tipos de evento inválidos o tope alcanzado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PendingMessage" } } }
          }
        }
      }
    },
    "/api/v1/webhooks/{id}": {
      "get": {
        "operationId": "pendingWebhookSubscription.show",
        "summary": "Ver una suscripción de webhook",
        "description": "No trae el secreto. Si lo perdiste, rotalo.\n\n**Pendiente de la especificación** (accounts origin/main @ c34cba2c).",
        "tags": ["Webhooks"],
        "x-fc-domain": "accounts",
        "x-fc-permission": "accounts:read",
        "x-fc-pending": "accounts-webhooks",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PendingWebhookSubscription" } } }
          }
        }
      },
      "put": {
        "operationId": "pendingWebhookSubscription.update",
        "summary": "Cambiar una suscripción de webhook",
        "description": "Reemplaza `url`, `events`, `description` y `filters`; `status` es opcional (`active` o `paused`). El secreto no cambia.\n\n**Pendiente de la especificación** (accounts origin/main @ c34cba2c).",
        "tags": ["Webhooks"],
        "x-fc-domain": "accounts",
        "x-fc-permission": "accounts:write",
        "x-fc-pending": "accounts-webhooks",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PendingWebhookSubscriptionUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PendingWebhookSubscription" } } }
          }
        }
      },
      "delete": {
        "operationId": "pendingWebhookSubscription.destroy",
        "summary": "Eliminar una suscripción de webhook",
        "description": "Borra la suscripción con su historial de entregas.\n\n**Pendiente de la especificación** (accounts origin/main @ c34cba2c).",
        "tags": ["Webhooks"],
        "x-fc-domain": "accounts",
        "x-fc-permission": "accounts:write",
        "x-fc-pending": "accounts-webhooks",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "204": { "description": "No Content" } }
      }
    },
    "/api/v1/webhooks/{id}/rotate-secret": {
      "post": {
        "operationId": "pendingWebhookSubscription.rotateSecret",
        "summary": "Generar un secreto nuevo",
        "description": "Devuelve el secreto nuevo una sola vez; el anterior deja de valer de inmediato.\n\n**Pendiente de la especificación** (accounts origin/main @ c34cba2c).",
        "tags": ["Webhooks"],
        "x-fc-domain": "accounts",
        "x-fc-permission": "accounts:write",
        "x-fc-pending": "accounts-webhooks",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PendingWebhookSubscriptionWithSecret" } } }
          }
        }
      }
    },
    "/api/v1/webhooks/{id}/test": {
      "post": {
        "operationId": "pendingWebhookSubscription.test",
        "summary": "Enviar ahora un evento de prueba",
        "description": "Una entrega firmada de `webhook.test`, sin reintentos. Queda en el historial.\n\n**Pendiente de la especificación** (accounts origin/main @ c34cba2c).",
        "tags": ["Webhooks"],
        "x-fc-domain": "accounts",
        "x-fc-permission": "accounts:write",
        "x-fc-pending": "accounts-webhooks",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PendingWebhookSubscriptionTestResult" } } }
          }
        }
      }
    },
    "/api/v1/webhooks/{id}/deliveries": {
      "get": {
        "operationId": "pendingWebhookSubscription.deliveries",
        "summary": "Ver el historial de entregas",
        "description": "Un registro por intento, lo más reciente primero. Pagina con `page` y `per_page` (25 por defecto, 100 como máximo).\n\n**Pendiente de la especificación** (accounts origin/main @ c34cba2c).",
        "tags": ["Webhooks"],
        "x-fc-domain": "accounts",
        "x-fc-permission": "accounts:read",
        "x-fc-pending": "accounts-webhooks",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "name": "event_type", "in": "query", "schema": { "type": "string" } },
          { "name": "event_id", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/PendingWebhookSubscriptionDelivery" } },
                    "links": {
                      "type": "object",
                      "properties": {
                        "first": { "type": ["string", "null"] },
                        "last": { "type": ["string", "null"] },
                        "prev": { "type": ["string", "null"] },
                        "next": { "type": ["string", "null"] }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "current_page": { "type": "integer" },
                        "last_page": { "type": "integer" },
                        "per_page": { "type": "integer" },
                        "total": { "type": "integer" }
                      },
                      "required": ["current_page", "last_page", "per_page", "total"]
                    }
                  },
                  "required": ["data", "links", "meta"]
                }
              }
            }
          }
        }
      }
    }
  },
  "operationPatches": [
    {
      "method": "post",
